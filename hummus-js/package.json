{
  "name": "hummus-js-root",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "devDependencies": {
    "wasm-pack": "^0.13.0"
  },
  "scripts": {
    "build:wasm:dev": "just build-hummus-js wasm",
    "build:wasm:release": "just build-hummus-js wasm --release",
    "build:tauri:dev": "just build-hummus-js tauri --dev --features  tauri",
    "build:tauri:release": "just build-hummus-js tauri --release --features tauri",
    "build:dev": "pnpm run build:wasm:dev && pnpm run build:tauri:dev",
    "build": "pnpm run build:wasm:release && pnpm run build:tauri:release",
    "prepare": "pnpm run build"
  }
}
